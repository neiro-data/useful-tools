# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
.env

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# SQLite data (canonical store, treated as local/scratch data)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Disposable sample database generated by `uv run python -m app.dummy_data`. Already covered by
# *.db above; listed explicitly so it is obvious this file is regenerated, never committed.
dummy.db

# Exports (e.g. CSV/report exports generated by the app)
exports/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Frontend (Node/Vite)
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
